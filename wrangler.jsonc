{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "florai-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "florai",
      "database_id": "b522ed6a-3535-42fa-a013-e9b1ce1dbf6b",
      "migrations_dir": "migrations"
    }
  ]
}
