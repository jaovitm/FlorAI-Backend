{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "florai-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PLAY_PACKAGE_NAME": "com.florai"
  },
  // Pushes de rega (src/jobs/watering-push.ts): checa a cada minuto o horário de cada lembrete.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "florai",
      "database_id": "b522ed6a-3535-42fa-a013-e9b1ce1dbf6b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "florai"
    }
  ]
}
